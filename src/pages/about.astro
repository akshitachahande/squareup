---
import BaseLayout from '../layouts/BaseLayout.astro';
import NumberedSteps from '../components/NumberedSteps.astro';
import SectionBanner from '../components/SectionBanner.astro';
import ThriveCard from '../components/ThriveCard.astro';
import { storyChapters } from '../data/about';
---

<BaseLayout
	title="About"
	description="The story of SquareUp, a digital product agency built on design, engineering and project management."
>
	<SectionBanner
		as="h1"
		title="About Us"
		image="/images/banners/why.webp"
		text="Welcome to SquareUp, where collaboration, expertise, and client-centricity intersect to shape the future of digital innovation."
	/>

	<section class="about" aria-labelledby="about-title">
		<div class="about__copy">
			<h2 id="about-title" class="about__title">About SquareUp</h2>
			<p class="about__text">
				SquareUp is a digital product agency that is passionate about crafting exceptional digital
				experiences. We specialize in design, engineering, and project management, helping businesses
				thrive in the digital landscape. At SquareUp, we follow a structured and collaborative process to
				ensure the successful delivery of exceptional digital products. Our process combines industry best
				practices, creative thinking, and a client-centric approach.
			</p>
		</div>
		<img
			class="about__image"
			src="/images/about/squareup.webp"
			alt=""
			width="598"
			height="571"
		/>
	</section>

	<section class="story" aria-labelledby="story-title">
		<h2 id="story-title" class="story__title">Our Story</h2>
		<NumberedSteps steps={storyChapters} tone="accent" />
	</section>

	<ThriveCard />
</BaseLayout>

<style>
	/* About SquareUp: copy beside the illustration */
	.about {
		display: grid;
		grid-template-columns: 1fr 598px;
		align-items: center;
		gap: 100px;
		padding: var(--space-intro) 120px;
		border-top: 1px solid var(--border);
	}

	.about__title {
		font-size: var(--fz-h2);
		font-weight: 600;
		line-height: 1.2;
	}

	.about__text {
		margin-top: 20px;
		color: var(--text-muted);
		font-size: 20px;
		line-height: 1.5;
	}

	.about__image {
		width: 100%;
		height: auto;
		aspect-ratio: 598 / 571;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	/* Our Story */
	.story {
		border-top: 1px solid var(--border);
	}

	.story__title {
		padding: var(--space-intro) var(--space-card) var(--space-card);
		font-size: var(--fz-h2);
		font-weight: 600;
		line-height: 1.2;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.about {
			grid-template-columns: 1fr 490px;
			gap: 80px;
			padding: var(--space-intro) 80px;
		}

		.about__text {
			margin-top: 14px;
			font-size: 16px;
		}

		.about__image {
			aspect-ratio: 490 / 482;
		}

	}

	/* Small laptop: the fixed image column would squeeze the copy */
	@media (max-width: 1279px) {
		.about {
			grid-template-columns: 1fr 1fr;
			gap: 56px;
			padding-inline: var(--space-section);
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.about {
			grid-template-columns: 1fr;
			gap: 30px;
			/* Runs edge to edge inside the frame, as in the design */
			padding: 40px 0;
		}

		.about__title {
			font-size: 28px;
		}

		.about__text {
			margin-top: 10px;
			font-size: 14px;
		}

		.about__image {
			aspect-ratio: 358 / 336;
		}

		.story__title {
			padding: var(--space-intro) 24px 24px;
		}
	}
</style>
