---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import NumberedSteps from '../components/NumberedSteps.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionBanner from '../components/SectionBanner.astro';
import { processSteps } from '../data/process';
---

<BaseLayout
	title="Process"
	description="How SquareUp runs a project, from discovery and design through launch and continuous improvement."
>
	<SectionBanner
		as="h1"
		title="Process of Starting the Project"
		image="/images/banners/faq.webp"
		text="At SquareUp, we value transparency, collaboration, and delivering exceptional results."
	/>

	<section class="process" aria-labelledby="process-title">
		<PageIntro
			id="process-title"
			title="At SquareUp"
			text="We follow a structured and collaborative process to ensure the successful delivery of exceptional digital products. Our process combines industry best practices, creative thinking, and a client-centric approach."
			label="Here's an overview of our typical process:"
		/>

		<NumberedSteps steps={processSteps} />
	</section>

	<ContactSection />
</BaseLayout>

<style>
	.process {
		border-top: 1px solid var(--border);
	}
</style>
