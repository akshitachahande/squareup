---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import SectionBanner from '../components/SectionBanner.astro';
import { works } from '../data/works';
---

<BaseLayout
	title="Work"
	description="A portfolio of digital products SquareUp has designed and built for its clients."
>
	<SectionBanner
		as="h1"
		title="Our Works"
		image="/images/banners/cta.webp"
		text="Discover a portfolio of visually stunning and strategically crafted digital projects that showcase our creativity and expertise."
	/>

	<section class="works" aria-labelledby="works-title">
		<div class="works__intro">
			<h2 id="works-title" class="works__title">At SquareUp</h2>
			<p class="works__text">
				We have had the privilege of working with a diverse range of clients and delivering exceptional
				digital products that drive success.
			</p>
			<p class="works__label">Here are ten examples of our notable works:</p>
		</div>

		<ul class="works__grid">
			{
				works.map((w) => (
					<li class="work">
						<h3 class="work__category">{w.category}</h3>
						<div class="work__body">
							<img
								class="work__image"
								src={w.image}
								alt={`${w.name} website and mobile mockups`}
								width="698"
								height="422"
								loading="lazy"
							/>
							<div class="work__meta">
								<p class="work__name">{w.name}</p>
								<p class="work__url">{w.url}</p>
								<a href="#" class="tile work__link" aria-label={`View the ${w.name} project`}>
									<Icon name="arrow-up-right" size={24} />
								</a>
							</div>
							<p class="work__text">{w.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<CtaBanner />
</BaseLayout>

<style>
	.works {
		border-top: 1px solid var(--border);
	}

	.works__intro {
		padding: 120px var(--space-card) var(--space-card);
	}

	.works__title {
		font-size: var(--fz-h2);
		font-weight: 600;
		line-height: 1.2;
	}

	.works__text {
		max-width: 1200px;
		margin-top: 14px;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.works__label {
		display: inline-block;
		margin-top: 50px;
		padding: 10px 14px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		font-size: 22px;
		line-height: 1.4;
	}

	.works__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.work {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--border);
	}

	.work:nth-child(even) {
		border-left: 1px solid var(--border);
	}

	.work__category {
		padding: 25px var(--space-card);
		border-bottom: 1px solid var(--border);
		color: var(--text-subtle);
		font-size: 26px;
		font-weight: 500;
		line-height: 1.5;
	}

	.work__body {
		flex: 1;
		padding: 30px var(--space-card) 100px;
	}

	.work__image {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
	}

	.work__meta {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		row-gap: 10px;
		margin-top: 30px;
	}

	.work__name {
		grid-column: 1;
		font-size: 24px;
		font-weight: 500;
		line-height: 1.5;
	}

	.work__url {
		grid-column: 1;
		justify-self: start;
		padding: 9px 14px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text-subtle);
		font-size: 20px;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.work__link {
		grid-column: 2;
		grid-row: 1 / 3;
		width: 52px;
		height: 52px;
		background: var(--surface);
		transition: background-color 0.2s;
	}

	.work__link:hover {
		background: var(--grey-20);
	}

	.work__text {
		margin-top: 30px;
		color: var(--text-muted);
		font-size: 20px;
		line-height: 1.35;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.works__intro {
			padding: 80px var(--space-card) var(--space-card);
		}

		.works__text {
			max-width: 920px;
			margin-top: 10px;
		}

		.works__label {
			margin-top: 40px;
			padding: 8px 10px;
			font-size: 18px;
		}

		.work__category {
			padding: 20px var(--space-card);
			font-size: 20px;
		}

		.work__body {
			padding: 30px var(--space-card) 80px;
		}

		.work__meta {
			margin-top: 24px;
		}

		.work__name {
			font-size: 18px;
		}

		.work__url {
			padding: 8px 12px;
			font-size: 16px;
		}

		.work__link {
			width: 46px;
			height: 46px;
		}

		.work__text {
			margin-top: 24px;
			font-size: 18px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.works__intro {
			padding: 40px 16px 30px;
		}

		.works__title {
			font-size: 28px;
		}

		.works__label {
			margin-top: 30px;
			font-size: 16px;
		}

		.works__grid {
			grid-template-columns: 1fr;
		}

		.work:nth-child(even) {
			border-left: 0;
		}

		.work__category {
			padding: 20px 24px;
			font-size: 20px;
		}

		.work__body {
			padding: 20px 24px 40px;
		}

		.work__meta {
			column-gap: 16px;
		}

		.work__name {
			font-size: 20px;
		}

		.work__url {
			padding: 10px 14px;
			font-size: 14px;
		}

		.work__link {
			grid-row: 2;
			width: 44px;
			height: 44px;
		}

		.work__text {
			font-size: 16px;
		}
	}
</style>
