---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../data/site';
import { revealBlur, revealSelector, revealZoom } from '../scripts/reveal-targets';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | A Digital Product Studio`;

// Starting state for the scroll reveal (see src/scripts/reveal.ts)
const revealCss = `
.reveal-ready :is(${revealSelector}):not(.reveal-done) {
	transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out), filter 0.8s var(--ease-out);
	transition-delay: var(--reveal-delay, 0ms);
}
.reveal-ready :is(${revealSelector}):not(.is-revealed) {
	opacity: 0;
	transform: translateY(28px);
}
.reveal-ready :is(${revealBlur.join(',')}):not(.is-revealed) {
	filter: blur(8px);
}
.reveal-ready :is(${revealZoom.join(',')}):not(.is-revealed) {
	transform: scale(0.92);
}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#191919" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<!--
			Opt in to scroll reveal before first paint, so content never flashes.
			Fail-safe: if the reveal script hasn't started within 3s (blocked or
			errored), drop the opt-in so nothing stays hidden.
		-->
		<script is:inline>
			if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				var root = document.documentElement;
				root.classList.add('reveal-ready');
				setTimeout(function () {
					if (!window.__reveal) root.classList.remove('reveal-ready');
				}, 3000);
			}
		</script>
		<style is:inline set:html={revealCss}></style>
	</head>
	<body>
		<Navbar />
		<main class="container frame">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/reveal';
			import '../scripts/spotlight';
		</script>
	</body>
</html>
