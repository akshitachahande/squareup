---
import Icon from '../Icon.astro';
import SectionBanner from '../SectionBanner.astro';
import { services } from '../../data/home';
---

<section aria-labelledby="services-title">
	<SectionBanner
		id="services-title"
		title="Our Services"
		image="/images/banners/services.webp"
		text="Transform your brand with our innovative digital solutions that captivate and engage your audience."
	/>

	<ul class="services">
		{
			services.map((s) => (
				<li class="service">
					<div class="service__head">
						<span class="tile service__icon">
							<Icon name={s.icon} size={34} />
						</span>
						<h3 class="service__title">{s.title}</h3>
					</div>
					<p class="service__text">{s.text}</p>
					<a href="/services" class="btn btn-secondary service__more">
						Learn More<span class="sr-only"> about {s.title}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.services {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}

	.service {
		display: flex;
		flex-direction: column;
		padding: var(--space-card);
	}

	.service + .service {
		border-left: 1px solid var(--border);
	}

	.service__head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 50px;
	}

	.service__icon {
		width: 88px;
		height: 88px;
	}

	.service__title {
		font-size: var(--fz-h3);
		font-weight: 600;
		line-height: 1.5;
	}

	.service__text {
		flex: 1;
		margin-top: 20px;
		color: var(--text-muted);
		line-height: 1.35;
	}

	.service__more {
		margin-top: var(--space-section);
		width: 100%;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.service__head {
			gap: 40px;
		}

		.service__icon {
			width: 70px;
			height: 70px;
		}

		.service__text {
			margin-top: 14px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.services {
			grid-template-columns: 1fr;
		}

		.service + .service {
			border-left: 0;
			border-top: 1px solid var(--border);
		}

		.service__head {
			flex-direction: row;
			align-items: center;
			gap: 14px;
		}

		.service__icon {
			width: 58px;
			height: 58px;
		}

		.service__icon :global(svg) {
			width: 28px;
			height: 28px;
		}

		.service__text {
			margin-top: 30px;
			line-height: 1.5;
		}

		.service__more {
			margin-top: 30px;
		}
	}
</style>
