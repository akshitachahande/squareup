---
import { audiences, brands } from '../../data/home';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__main">
		<h1 class="hero__title" id="hero-title">A Digital Product Studio <br />that will Work</h1>

		<p class="hero__for">
			<span class="hero__for-desktop">
				For
				{
					audiences.map((a, i) => (
						<>
							<span class="hero__chip" style={`--i: ${i}`}>
								{a}
							</span>
							{i < audiences.length - 2 && <span class="hero__sep">,</span>}
							{i === audiences.length - 2 && 'and'}
						</>
					))
				}
			</span>
			<span class="hero__for-mobile">
				For startups, enterprise leaders, media &amp; publishers, and social good.
			</span>
		</p>

		<div class="hero__actions">
			<a href="/work" class="btn btn-outline">Our Works</a>
			<a href="/contact" class="btn btn-primary">Contact Us</a>
		</div>

		<img class="hero__mountain" src="/images/abstract/mountain.svg" alt="" width="713" height="200" />
	</div>

	<div class="brands">
		<p class="brands__badge">Trusted By 250+ Companies</p>
		<!-- The list is repeated so the marquee loops without a gap -->
		<div class="brands__marquee">
			<div class="brands__track">
				{
					[0, 1].map((copy) => (
						<ul class="brands__list" aria-hidden={copy === 1 ? 'true' : undefined}>
							{brands.map((b) => (
								<li>
									<img
										src={b.src}
										alt={copy === 0 ? b.name : ''}
										width={b.width}
										height="60"
										loading="lazy"
									/>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.hero__main {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 796px;
		padding: 120px 20px 0;
		overflow: hidden;
		text-align: center;
		background:
			linear-gradient(to bottom, var(--bg) 0%, transparent 25%),
			var(--dot-pattern);
		border-bottom: 1px solid var(--border);
	}

	/* Soft lime glow behind the title */
	.hero__main::before {
		content: '';
		position: absolute;
		top: 4%;
		left: 50%;
		width: min(80%, 1000px);
		aspect-ratio: 2 / 1;
		transform: translateX(-50%);
		background: radial-gradient(closest-side, rgb(158 255 0 / 0.13), transparent);
		pointer-events: none;
	}

	.hero__title {
		position: relative;
		z-index: 1;
		font-size: var(--fz-display);
		font-weight: 600;
		line-height: 1.2;
	}

	.hero__for {
		position: relative;
		z-index: 1;
		margin-top: 50px;
		padding: 14px;
		padding-left: 40px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: rgb(25 25 25 / 0.6);
		color: var(--text-subtle);
		font-size: var(--fz-h5);
		line-height: 1.5;
	}

	.hero__for-desktop {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.hero__for-mobile {
		display: none;
	}

	.hero__chip {
		padding: 10px 14px;
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__main::before {
			animation: hero-glow 7s ease-in-out infinite;
		}

		/* Each audience chip lights up in turn */
		.hero__chip {
			animation: chip-cycle 8s ease-in-out infinite;
			animation-delay: calc(var(--i) * 2s + 1s);
		}
	}

	@keyframes hero-glow {
		50% {
			opacity: 0.55;
			transform: translateX(-50%) scale(1.12);
		}
	}

	@keyframes chip-cycle {
		0%,
		100% {
			background: var(--surface);
			color: var(--text-muted);
		}
		6%,
		22% {
			background: rgb(158 255 0 / 0.12);
			color: var(--accent);
		}
		30% {
			background: var(--surface);
			color: var(--text-muted);
		}
	}

	.hero__actions {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 14px;
		margin-top: 50px;
	}

	/* Wireframe mountain sits on the bottom edge, behind the content */
	.hero__mountain {
		position: absolute;
		left: 50%;
		bottom: 0;
		width: min(97%, 1560px);
		max-width: none;
		height: auto;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.brands {
		position: relative;
	}

	.brands__badge {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 1;
		transform: translateX(-50%);
		padding: 18px 34px;
		border: 1px solid var(--border);
		border-radius: 100px;
		background: var(--bg);
		font-size: var(--fz-ui);
		font-weight: 500;
		white-space: nowrap;
	}

	/* Logos scroll endlessly, fading out at both edges */
	.brands__marquee {
		--gap: 120px;
		display: flex;
		align-items: center;
		/* Top padding clears the badge, which hangs from the hero's border */
		min-height: 202px;
		padding: 58px 0 28px;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}

	.brands__track {
		display: flex;
		width: max-content;
	}

	/* padding-right matches the gap so the two copies join seamlessly */
	.brands__list {
		display: flex;
		flex: none;
		align-items: center;
		gap: var(--gap);
		padding-right: var(--gap);
	}

	.brands__list img {
		width: auto;
		height: 60px;
		opacity: 0.75;
		transition:
			opacity 0.3s,
			transform 0.3s var(--ease-out);
	}

	.brands__list img:hover {
		opacity: 1;
		transform: scale(1.06);
	}

	@media (prefers-reduced-motion: no-preference) {
		.brands__track {
			animation: marquee 40s linear infinite;
		}

		.brands__marquee:hover .brands__track {
			animation-play-state: paused;
		}
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* No motion: one static, wrapping row */
	@media (prefers-reduced-motion: reduce) {
		.brands__marquee {
			mask-image: none;
		}

		.brands__track {
			width: 100%;
		}

		.brands__list {
			flex: 1;
			flex-wrap: wrap;
			justify-content: space-around;
			gap: 24px 40px;
			padding-inline: 20px;
		}

		.brands__list + .brands__list {
			display: none;
		}
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.hero__main {
			min-height: 690px;
			padding: 110px 20px 0;
		}

		.hero__for {
			margin-top: 40px;
			padding: 10px;
			padding-left: 30px;
		}

		.hero__for-desktop {
			gap: 6px;
		}

		.hero__chip {
			padding: 6px 10px;
		}

		.brands__badge {
			padding: 14px 24px;
		}

		.brands__marquee {
			--gap: 90px;
			min-height: 154px;
			padding: 41px 0 23px;
		}

		.brands__list img {
			height: 48px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.hero__main {
			min-height: 568px;
			padding: 80px 0 0;
		}

		.hero__for {
			margin-top: 30px;
			padding: 14px 24px;
		}

		.hero__for-desktop {
			display: none;
		}

		.hero__for-mobile {
			display: block;
		}

		.hero__actions {
			margin-top: 40px;
		}

		.hero__mountain {
			width: 210%;
			bottom: 0;
		}

		.brands__badge {
			font-size: 14px;
			padding: 14px 24px;
		}

		.brands__marquee {
			--gap: 56px;
			min-height: 0;
			padding: 66px 0 26px;
			mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
		}

		.brands__track {
			animation-duration: 28s;
		}

		.brands__list img {
			height: 38px;
		}
	}
</style>
