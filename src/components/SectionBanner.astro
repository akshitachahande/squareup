---
/**
 * The dark header strip that opens each section ("Our Services", "FAQ"...).
 *
 * Each banner has its own 3D wave image (public/images/banners, exported
 * from Figma with the overlay and dot pattern baked in). Without `image`
 * the strip falls back to a CSS approximation (green glows + dot pattern).
 */
interface Props {
	title: string;
	text?: string;
	image?: string;
	/** Heading level; the first banner on inner pages should be h1 */
	as?: 'h1' | 'h2';
	/** id for the heading, for aria-labelledby */
	id?: string;
	class?: string;
}

const { title, text, image, as: Heading = 'h2', id, class: className } = Astro.props;
---

<div
	class:list={['banner', className]}
	style={image ? `--banner-image: url('${image}')` : undefined}
>
	<slot name="before" />
	<Heading id={id} class="banner__title">{title}</Heading>
	{text && <p class="banner__text">{text}</p>}
	<slot />
</div>

<style>
	.banner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		/*
		 * Height comes from the padding, so two-line banners grow as in the
		 * design. Callers can't reach this element with scoped styles, so
		 * --banner-min-height(-mobile) and --banner-padding-block-mobile are
		 * the override hooks.
		 */
		min-height: var(--banner-min-height, 0);
		padding: 120px var(--space-card);
		overflow: hidden;
		text-align: center;
		background:
			var(--banner-image, none) center / cover no-repeat,
			radial-gradient(60% 120% at 12% 100%, rgb(158 255 0 / 0.07), transparent 70%),
			radial-gradient(50% 90% at 85% 0%, rgb(158 255 0 / 0.05), transparent 70%),
			var(--dot-pattern),
			#0f0f0f;
	}

	.banner__title {
		font-size: var(--fz-h2);
		font-weight: 600;
		line-height: 1.2;
	}

	.banner__text {
		max-width: 1000px;
		color: var(--text-muted);
		font-size: var(--fz-body);
		line-height: 1.5;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.banner {
			padding-block: 98px;
		}

		.banner__text {
			max-width: 760px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.banner {
			min-height: var(--banner-min-height-mobile, 190px);
			gap: 10px;
			padding: var(--banner-padding-block-mobile, 50px) 24px;
		}
	}
</style>
