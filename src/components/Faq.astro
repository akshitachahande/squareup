---
import Icon from './Icon.astro';
import SectionBanner from './SectionBanner.astro';
import { faqs } from '../data/faqs';
import { site } from '../data/site';

const half = Math.ceil(faqs.length / 2);
const columns = [faqs.slice(0, half), faqs.slice(half)];
---

<section class="faq" aria-labelledby="faq-title">
	<SectionBanner id="faq-title" title="Frequently Asked Questions" image="/images/banners/faq.webp">
		<p class="faq__intro">
			Still you have any questions? Contact our Team via <a href={`mailto:${site.email}`}>{site.email}</a>
		</p>
	</SectionBanner>

	<div class="faq__grid">
		{
			columns.map((items, col) => (
				<div class="faq__col">
					{items.map((item, i) => {
						const n = col * half + i + 1;
						return (
							<details class="faq__item" name="faq" open={n === 1}>
								<summary>
									<span class="tile faq__num">{String(n).padStart(2, '0')}</span>
									<span class="faq__q">{item.question}</span>
									{/* One plus that turns 45° into a cross when open */}
									<span class="faq__icon">
										<Icon name="plus" size={30} />
									</span>
								</summary>
								<div class="faq__panel">
									<p class="faq__a">{item.answer}</p>
								</div>
							</details>
						);
					})}
				</div>
			))
		}
	</div>
</section>

<script>
	/*
	 * Smooth accordion. <details name="faq"> already gives one-open-at-a-time
	 * without JS; here the open/close is animated instead of snapping.
	 * data-state flips immediately so the colour and icon change with the
	 * motion, while [open] is only removed once the panel has closed.
	 */
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq__item')];
	const timing = { duration: 420, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' };
	const running = new WeakMap<HTMLDetailsElement, Animation>();

	for (const item of items) {
		item.dataset.state = item.open ? 'open' : 'closed';
		// We manage exclusivity ourselves so the other item can animate closed
		item.removeAttribute('name');
	}

	function animatePanel(item: HTMLDetailsElement, opening: boolean) {
		const panel = item.querySelector<HTMLElement>('.faq__panel')!;
		running.get(item)?.cancel();
		item.dataset.state = opening ? 'open' : 'closed';

		if (reduceMotion.matches) {
			item.open = opening;
			return;
		}

		if (opening) item.open = true;
		const height = panel.scrollHeight;
		// The resolved --a-pull (the panel tucks up under the question)
		const pull = getComputedStyle(panel).marginTop;
		const open = { height: `${height}px`, marginTop: pull, opacity: 1 };
		const shut = { height: '0px', marginTop: '0px', opacity: 0 };

		panel.style.overflow = 'hidden';
		const animation = panel.animate(opening ? [shut, open] : [open, shut], timing);
		running.set(item, animation);
		animation.onfinish = () => {
			panel.style.overflow = '';
			if (!opening) item.open = false;
			running.delete(item);
		};
	}

	for (const item of items) {
		item.querySelector('summary')!.addEventListener('click', (event) => {
			event.preventDefault();
			const opening = item.dataset.state !== 'open';
			if (opening) {
				for (const other of items) {
					if (other !== item && other.dataset.state === 'open') animatePanel(other, false);
				}
			}
			animatePanel(item, opening);
		});
	}
</script>

<style>
	.faq__intro {
		color: var(--text-muted);
		font-size: var(--fz-body);
	}

	.faq__intro a:hover {
		color: var(--accent);
	}

	.faq__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	/* Empty band above the questions, as in the design */
	.faq__col {
		padding-block: var(--space-section);
	}

	.faq__col + .faq__col {
		border-left: 1px solid var(--border);
	}

	.faq__item {
		border-top: 1px solid var(--border);
	}

	.faq__item:last-child {
		border-bottom: 1px solid var(--border);
	}

	.faq__item {
		--num: 80px;
		--gap: 30px;
		--py: 30px;
		/* How far the answer tucks up under the question row */
		--a-pull: -26px;
	}

	summary {
		display: flex;
		align-items: center;
		gap: var(--gap);
		padding: var(--py) var(--space-card);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.faq__num {
		width: var(--num);
		height: var(--num);
		color: var(--text);
		font-size: 30px;
		font-weight: 600;
	}

	.faq__q {
		flex: 1;
		font-size: var(--fz-h5);
		font-weight: 500;
		line-height: 1.5;
	}

	.faq__num,
	.faq__q,
	.faq__icon {
		transition: color 0.3s;
	}

	.faq__num {
		transition:
			color 0.3s,
			transform 0.4s var(--ease-out);
	}

	.faq__icon {
		flex: none;
		color: var(--text);
		transition:
			color 0.3s,
			transform 0.45s var(--ease-out);
	}

	/* Open: green, and the plus turns into a cross. data-state is set by the
	   accordion script so this follows the motion; [open] covers no-JS. */
	.faq__item:is([data-state='open'], [open]:not([data-state])) :is(.faq__num, .faq__q, .faq__icon) {
		color: var(--accent);
	}

	.faq__item:is([data-state='open'], [open]:not([data-state])) .faq__icon {
		transform: rotate(45deg);
	}

	summary:hover .faq__num {
		transform: scale(1.06);
	}

	/* Answer lines up under the question text */
	.faq__panel {
		margin-top: var(--a-pull);
	}

	.faq__a {
		padding: 0 calc(var(--space-card) + var(--gap)) var(--py)
			calc(var(--space-card) + var(--num) + var(--gap));
		color: var(--text-muted);
		font-size: var(--fz-body);
		line-height: 1.5;
	}

	summary:hover .faq__q {
		color: var(--green-60);
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.faq__item {
			--num: 60px;
			--gap: 24px;
			--py: 25px;
			--a-pull: -12px;
		}

		.faq__num {
			font-size: 24px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.faq__grid {
			grid-template-columns: 1fr;
		}

		.faq__col {
			padding-block: 0;
		}

		.faq__col + .faq__col {
			border-left: 0;
		}

		.faq__col:first-child .faq__item:first-child {
			border-top: 0;
		}

		.faq__col:first-child .faq__item:last-child {
			border-bottom: 0;
		}

		.faq__item {
			--num: 52px;
			--gap: 20px;
			--py: 24px;
			--a-pull: calc(var(--py) * -0.5);
		}

		summary {
			padding-inline: 24px;
		}

		.faq__num {
			font-size: 20px;
		}

		.faq__a {
			padding-inline: 24px;
		}
	}
</style>
