---
/**
 * The tall wave banner with the green cube and "Start Project" button.
 * Closes most pages ("Let us Bring your Ideas to Life...") and opens the
 * contact form section.
 */
import SectionBanner from './SectionBanner.astro';

interface Props {
	title?: string;
	text?: string;
	href?: string;
	id?: string;
	class?: string;
}

const {
	title = 'Let us Bring your Ideas to Life in the Digital World.',
	text = 'No matter which services you choose, we are committed to delivering exceptional results that exceed your expectations. Our multidisciplinary team works closely together to ensure seamless collaboration and a unified vision for your digital product.',
	href = '/contact#contact-fields',
	id,
	class: className,
} = Astro.props;
---

<SectionBanner id={id} class:list={['cta', className]} title={title} text={text} image="/images/banners/cta.webp">
	<img
		slot="before"
		class="cta__cube"
		src="/images/abstract/cube.svg"
		alt=""
		width="201"
		height="200"
	/>
	<a href={href} class="btn btn-primary cta__start">Start Project</a>
</SectionBanner>

<style>
	/*
	 * `.cta` lands on SectionBanner's root element, which is outside this
	 * component's style scope, so those selectors are global. `.banner.cta`
	 * outranks SectionBanner's own scoped rules.
	 */
	:global(.banner.cta) {
		--banner-min-height: 597px;
	}

	:global(.banner.cta .banner__title) {
		font-size: 38px;
		font-weight: 500;
	}

	:global(.banner.cta .banner__text) {
		max-width: 900px;
	}

	/* Margins below add to the banner's 14px flex gap */
	.cta__cube {
		width: 80px;
		height: auto;
		margin-bottom: 39px;
		border-radius: 12px;
		box-shadow: 0 0 40px rgb(158 255 0 / 0.25);
	}

	.cta__start {
		margin-top: 36px;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		:global(.banner.cta) {
			--banner-min-height: 480px;
		}

		:global(.banner.cta .banner__title) {
			font-size: 28px;
		}

		:global(.banner.cta .banner__text) {
			max-width: 760px;
		}

		.cta__cube {
			width: 60px;
			margin-bottom: 30px;
		}

		.cta__start {
			margin-top: 24px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		:global(.banner.cta) {
			--banner-min-height-mobile: 390px;
			--banner-padding-block-mobile: 50px;
		}

		:global(.banner.cta .banner__title) {
			font-size: 24px;
		}

		.cta__cube {
			width: 50px;
			margin-bottom: 20px;
		}

		.cta__start {
			margin-top: 30px;
		}
	}
</style>
