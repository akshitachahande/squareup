---
/**
 * Maps the icon names used in src/data to Lucide components, plus the three
 * social brand marks Lucide doesn't ship (paths from Simple Icons, CC0).
 */
import {
	AppWindow,
	ArrowUpRight,
	BatteryCharging,
	Blocks,
	BookOpen,
	BriefcaseBusiness,
	Brush,
	Bug,
	Building,
	ChartLine,
	Check,
	CircleDashed,
	ClipboardList,
	Code,
	CodeXml,
	Cog,
	Coins,
	Crown,
	Gauge,
	Layers,
	ListChecks,
	ListTree,
	Mail,
	MapPin,
	Medal,
	Milestone,
	MonitorSmartphone,
	MousePointer2,
	MousePointerClick,
	Newspaper,
	Paintbrush,
	Phone,
	Plus,
	Presentation,
	Puzzle,
	RefreshCw,
	Repeat,
	Rocket,
	ScrollText,
	Shapes,
	ShieldAlert,
	ShieldCheck,
	ShieldHalf,
	ShoppingCart,
	Smartphone,
	Sparkles,
	SquareDashedMousePointer,
	SquareKanban,
	SquareTerminal,
	TabletSmartphone,
	Target,
	TextAlignEnd,
	TrendingUp,
	Type,
	Users,
	UsersRound,
	Wrench,
	X,
	Zap,
} from '@lucide/astro';

const lucide = {
	'app-window': AppWindow,
	'arrow-up-right': ArrowUpRight,
	'battery-charging': BatteryCharging,
	blocks: Blocks,
	'book-open': BookOpen,
	'briefcase-business': BriefcaseBusiness,
	brush: Brush,
	bug: Bug,
	building: Building,
	'chart-line': ChartLine,
	check: Check,
	'circle-dashed': CircleDashed,
	'clipboard-list': ClipboardList,
	code: Code,
	'code-xml': CodeXml,
	cog: Cog,
	coins: Coins,
	crown: Crown,
	gauge: Gauge,
	layers: Layers,
	'list-checks': ListChecks,
	'list-tree': ListTree,
	mail: Mail,
	'map-pin': MapPin,
	medal: Medal,
	menu: TextAlignEnd,
	milestone: Milestone,
	'monitor-smartphone': MonitorSmartphone,
	'mouse-pointer-2': MousePointer2,
	'mouse-pointer-click': MousePointerClick,
	newspaper: Newspaper,
	paintbrush: Paintbrush,
	phone: Phone,
	plus: Plus,
	presentation: Presentation,
	puzzle: Puzzle,
	'refresh-cw': RefreshCw,
	repeat: Repeat,
	rocket: Rocket,
	'scroll-text': ScrollText,
	shapes: Shapes,
	'shield-alert': ShieldAlert,
	'shield-check': ShieldCheck,
	'shield-half': ShieldHalf,
	'shopping-cart': ShoppingCart,
	smartphone: Smartphone,
	sparkles: Sparkles,
	'square-dashed-mouse-pointer': SquareDashedMousePointer,
	'square-kanban': SquareKanban,
	'square-terminal': SquareTerminal,
	'tablet-smartphone': TabletSmartphone,
	target: Target,
	'trending-up': TrendingUp,
	type: Type,
	users: Users,
	'users-round': UsersRound,
	wrench: Wrench,
	x: X,
	zap: Zap,
};

const brands = {
	facebook:
		'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
	twitter:
		'M21.543 7.104c.015.211.015.423.015.636 0 6.507-4.954 14.01-14.01 14.01v-.003A13.94 13.94 0 0 1 0 19.539a9.88 9.88 0 0 0 7.287-2.041 4.93 4.93 0 0 1-4.6-3.42 4.916 4.916 0 0 0 2.223-.084A4.926 4.926 0 0 1 .96 9.167v-.062a4.887 4.887 0 0 0 2.235.616A4.928 4.928 0 0 1 1.67 3.148 13.98 13.98 0 0 0 11.82 8.292a4.929 4.929 0 0 1 8.39-4.49 9.868 9.868 0 0 0 3.128-1.196 4.941 4.941 0 0 1-2.165 2.724A9.828 9.828 0 0 0 24 4.555a10.019 10.019 0 0 1-2.457 2.549z',
	linkedin:
		'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};

export type IconName = keyof typeof lucide | keyof typeof brands;

interface Props {
	name: IconName;
	size?: number | string;
	class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const LucideIcon = name in lucide ? lucide[name as keyof typeof lucide] : null;
const brandPath = name in brands ? brands[name as keyof typeof brands] : null;
---

{
	LucideIcon ? (
		<LucideIcon size={size} class={className} aria-hidden="true" />
	) : (
		<svg
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="currentColor"
			class={className}
			aria-hidden="true"
		>
			<path d={brandPath} />
		</svg>
	)
}
