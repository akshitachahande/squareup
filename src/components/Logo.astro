---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="SquareUp home">
	<img src="/images/logo.svg" alt="" width="178" height="60" />
</a>

<style>
	.logo {
		display: block;
		flex: none;
		height: 60px;
	}

	.logo img {
		width: auto;
		height: 100%;
	}

	/* Laptop (1440 frame) */
	@media (max-width: 1799px) {
		.logo {
			height: 40px;
		}
	}

	/* Mobile (390 frame) */
	@media (max-width: 1023px) {
		.logo {
			height: 40px;
		}
	}
</style>
